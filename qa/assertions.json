{
  "_meta": {
    "descricao": "QA assertion matrix of the olx-br package. Single source of truth of the live suite (qa/live.test.js).",
    "verificado_em": "2026-10-20",
    "verificado_por": "Deck (QA) - live probes against apps.olx.com.br / auth.olx.com.br",
    "regra": "NEVER test against www.olx.com.br (403 Cloudflare). It is not a contract.",
    "campos": {
      "host": "apps | auth",
      "estavel": "false = the answer changes between calls; the harness accepts any status of 'aceita' and reports the row as unstable",
      "aceita": "list of acceptable statuses when estavel=false"
    }
  },
  "matriz": [
    {
      "id": "A01",
      "host": "apps",
      "endpoint": "/autoupload/import",
      "method": "PUT",
      "auth": "body",
      "request": { "access_token": "$TOKEN", "ad_list": [{ "subject": "qa" }] },
      "status": 200,
      "body": { "token": null, "statusCode": -6, "statusMessage": "Without permission", "errors": [] },
      "estavel": true,
      "observacao": "Resolve (nao rejeita) mesmo com erro de aplicacao. Chamador DEVE checar statusCode. Cobre putAnuncios e deleteAnuncios."
    },
    {
      "id": "A02",
      "host": "apps",
      "endpoint": "/autoupload/import",
      "method": "PUT",
      "auth": "body",
      "request": { "access_token": "$TOKEN", "ad_list": [] },
      "status": 200,
      "body": { "token": null, "statusCode": -3, "statusMessage": "There is no ad to import", "errors": [] },
      "estavel": true,
      "observacao": "statusCode -3 = nada para importar. Continua HTTP 200."
    },
    {
      "id": "A03",
      "host": "apps",
      "endpoint": "/autoupload/import",
      "method": "POST",
      "auth": "body",
      "request": { "access_token": "$TOKEN", "ad_list": [{ "subject": "qa" }] },
      "status": 404,
      "body": "Cannot POST /autoupload/import",
      "estavel": true,
      "observacao": "Metodo errado -> HTML (Express), nao JSON. A lib usa PUT. Rastreio de metodo errado quebra a lib."
    },
    {
      "id": "A04",
      "host": "apps",
      "endpoint": "/autoupload/import/{token}",
      "method": "POST",
      "auth": "body",
      "request": { "access_token": "$TOKEN" },
      "status": 200,
      "body": { "token": null, "statusCode": -6, "statusMessage": "Without permission", "errors": [] },
      "estavel": true,
      "observacao": "Cobre getStatusAnuncio. Token de anuncio invalido cai no mesmo -6."
    },
    {
      "id": "A05",
      "host": "apps",
      "endpoint": "/autoupload/published",
      "method": "POST",
      "auth": "body",
      "request": { "access_token": "$TOKEN" },
      "status": 404,
      "body": { "status": "ERROR", "error": { "reason": "ACCESS_TOKEN_NOT_FOUND", "message": "Response code 404 (Not Found)", "statusCode": 404 } },
      "estavel": true,
      "observacao": "Formato de erro JSON do grupo autoupload. getAnuncios rejeita com este objeto."
    },
    {
      "id": "A06",
      "host": "apps",
      "endpoint": "/autoupload/published",
      "method": "POST",
      "auth": "bearer",
      "request": null,
      "aceita": [400, 500],
      "estavel": false,
      "observacao": "INSTAVEL: 1a vez 400 INVALID_PAYLOAD, 2a vez 500 UNEXPECTED_ERROR. Serve so para provar que o token vai no CORPO e nao no header. NAO usar como contrato."
    },
    {
      "id": "A07",
      "host": "apps",
      "endpoint": "/autoupload/car_info",
      "method": "POST",
      "auth": "body",
      "request": { "access_token": "$TOKEN" },
      "status": 404,
      "body": { "status": "ERROR", "error": { "reason": "ACCESS_TOKEN_NOT_FOUND", "message": "Response code 404 (Not Found)", "statusCode": 404 } },
      "estavel": true,
      "observacao": "getModelosCarros sem id."
    },
    {
      "id": "A08",
      "host": "apps",
      "endpoint": "/autoupload/car_info/{marca}",
      "method": "POST",
      "auth": "body",
      "request": { "access_token": "$TOKEN" },
      "status": 404,
      "body": { "status": "ERROR", "error": { "reason": "ACCESS_TOKEN_NOT_FOUND", "message": "Response code 404 (Not Found)", "statusCode": 404 } },
      "estavel": true,
      "observacao": "getModelosCarros(AT, 1)."
    },
    {
      "id": "A09",
      "host": "apps",
      "endpoint": "/autoupload/car_info/{marca}/{modelo}",
      "method": "POST",
      "auth": "body",
      "request": { "access_token": "$TOKEN" },
      "status": 404,
      "body": { "status": "ERROR", "error": { "reason": "ACCESS_TOKEN_NOT_FOUND", "message": "Response code 404 (Not Found)", "statusCode": 404 } },
      "estavel": true,
      "observacao": "getModelosCarros(AT, 1, 2)."
    },
    {
      "id": "A10",
      "host": "apps",
      "endpoint": "/autoupload/moto_info",
      "method": "POST",
      "auth": "body",
      "request": { "access_token": "$TOKEN" },
      "status": 404,
      "body": { "status": "ERROR", "error": { "reason": "ACCESS_TOKEN_NOT_FOUND", "message": "Response code 404 (Not Found)", "statusCode": 404 } },
      "estavel": true,
      "observacao": "getModelosMotos sem id."
    },
    {
      "id": "A11",
      "host": "apps",
      "endpoint": "/autoupload/moto_info/{marca}",
      "method": "POST",
      "auth": "body",
      "request": { "access_token": "$TOKEN" },
      "status": 404,
      "body": { "status": "ERROR", "error": { "reason": "ACCESS_TOKEN_NOT_FOUND", "message": "Response code 404 (Not Found)", "statusCode": 404 } },
      "estavel": true,
      "observacao": "getModelosMotos(AT, 7)."
    },
    {
      "id": "A12",
      "host": "apps",
      "endpoint": "/autoupload/moto_cubiccms_info",
      "method": "POST",
      "auth": "body",
      "request": { "access_token": "$TOKEN" },
      "status": 404,
      "body": { "status": "ERROR", "error": { "reason": "ACCESS_TOKEN_NOT_FOUND", "message": "Response code 404 (Not Found)", "statusCode": 404 } },
      "estavel": true,
      "observacao": "getCilindradas. NAO existe variante com id."
    },
    {
      "id": "A13",
      "host": "apps",
      "endpoint": "/autoupload/moto_cubiccms_info/{id}",
      "method": "POST",
      "auth": "body",
      "request": { "access_token": "$TOKEN" },
      "status": 404,
      "body": "Cannot POST /v0/moto_cubiccms_info/600",
      "estavel": true,
      "observacao": "Path inexistente -> HTML com alias /v0/. Nao usar como contrato, mas prova que path invalido nao vira JSON."
    },
    {
      "id": "A14",
      "host": "apps",
      "endpoint": "/oauth_api/basic_user_info",
      "method": "POST",
      "auth": "body",
      "request": { "access_token": "$TOKEN" },
      "status": 400,
      "body": "<EMPTY>",
      "estavel": true,
      "observacao": "DEFECTO D1: corpo vazio -> a lib rejeita com o objeto axios (err.response.data e falsio -> fallback `|| err`). O status 400 se perde para quem so le o payload."
    },
    {
      "id": "A15",
      "host": "apps",
      "endpoint": "/oauth_api/basic_user_info",
      "method": "POST",
      "auth": "bearer",
      "request": null,
      "status": 400,
      "body": [{ "property": "access_token", "message": "is missing and it is required" }],
      "estavel": true,
      "observacao": "Mesmo endpoint, corpo em ARRAY. 2o formato de erro do mesmo endpoint."
    },
    {
      "id": "A16",
      "host": "auth",
      "endpoint": "/oauth/token",
      "method": "POST",
      "auth": "form",
      "request": { "code": "fake", "client_id": "fake", "client_secret": "fake", "redirect_uri": "http://localhost/cb", "grant_type": "authorization_code" },
      "status": 400,
      "body": { "error": "invalid_client" },
      "estavel": true,
      "observacao": "Credencial falsa. Formato de erro do host de auth (campo `error` solto). getToken rejeita com este objeto."
    },
    {
      "id": "A17",
      "host": "apps",
      "endpoint": "/autoservice/v1/chat",
      "method": "POST",
      "auth": "bearer",
      "request": null,
      "status": 401,
      "body": { "message": "Unauthorized" },
      "estavel": true,
      "observacao": "Formato de erro do grupo autoservice: {message} apenas."
    },
    {
      "id": "A18",
      "host": "apps",
      "endpoint": "/autoservice/v1/chat/send",
      "method": "POST",
      "auth": "bearer",
      "request": null,
      "status": 401,
      "body": { "message": "Unauthorized" },
      "estavel": true,
      "observacao": "Idem A17."
    },
    {
      "id": "A19",
      "host": "apps",
      "endpoint": "/autoservice/v1/chat",
      "method": "DELETE",
      "auth": "bearer",
      "request": null,
      "status": 401,
      "body": { "message": "Unauthorized" },
      "estavel": true,
      "observacao": "Idem A17."
    },
    {
      "id": "A20",
      "host": "apps",
      "endpoint": "/autoservice/v1/chat",
      "method": "POST",
      "auth": "body",
      "request": { "access_token": "$TOKEN" },
      "status": 400,
      "body": { "message": "Bad request: accessToken is required" },
      "estavel": true,
      "observacao": "autoservice usa camelCase `accessToken`, nao `access_token`. Contrato DIFERENTE do autoupload. Relevante para o PR de escopos+chat."
    },
    {
      "id": "A21",
      "host": "apps",
      "endpoint": "/autoservice/v1/lead",
      "method": "POST",
      "auth": "bearer",
      "request": null,
      "aceita": [401, 500],
      "estavel": false,
      "observacao": "INSTAVEL (Quim viu 401 e 500 truncado). 3o formato no autoservice: {reason,message} no topo. NAO usar como contrato."
    },
    {
      "id": "A22",
      "host": "apps",
      "endpoint": "/autoupload/car_info",
      "method": "GET",
      "auth": "bearer",
      "request": null,
      "status": 404,
      "body": "Cannot GET /v0/car_info",
      "estavel": true,
      "observacao": "GET e reescrito para /v0/. Metodo errado -> HTML."
    },
    {
      "id": "A23",
      "host": "apps",
      "endpoint": "/autoupload/published",
      "method": "GET",
      "auth": "bearer",
      "request": null,
      "status": 404,
      "body": "Cannot GET /v0/published",
      "estavel": true,
      "observacao": "Idem A22."
    },
    {
      "id": "A24",
      "host": "apps",
      "endpoint": "/autoupload/import/{token}",
      "method": "GET",
      "auth": "bearer",
      "request": null,
      "status": 404,
      "body": "Cannot GET /autoupload/import/abc",
      "estavel": true,
      "observacao": "Idem A22, sem alias /v0/ aqui."
    },
    {
      "id": "A25",
      "host": "auth",
      "endpoint": "/oauth",
      "method": "GET",
      "auth": "query",
      "request": { "response_type": "code", "client_id": "CID_FAKE", "redirect_uri": "http://localhost:3000/cb", "scope": "basic_user_info autoupload" },
      "status": 302,
      "body": "Location: https://conta.olx.com.br/acesso?returnToToken=",
      "estavel": true,
      "observacao": "getAuthUrl. Verificado: 1 barra, 2 barras, %20 e + - TODOS devolvem 302. O JWT embute redirect_uri, scope e client_id: alterar a query quebra o login. Nao mexer."
    },
    {
      "id": "A26",
      "host": "apps",
      "endpoint": "/",
      "method": "GET",
      "auth": "none",
      "request": null,
      "aceita": [403, 404],
      "estavel": false,
      "observacao": "INSTAVEL: ora 403 Cloudflare, ora 404 {message: no Route matched}. Nao serve como health check."
    }
  ],
  "fora_do_escopo": [
    { "endpoint": "https://www.olx.com.br", "motivo": "403 Cloudflare - proibido testar" },
    { "endpoint": "/autoservice/v1/lead", "motivo": "instavel (401 ou 500 truncado)" },
    { "endpoint": "/autoupload/published com Bearer", "motivo": "instavel (400 ou 500)" },
    { "endpoint": "raiz de apps.olx.com.br", "motivo": "instavel (403 ou 404)" },
    { "endpoint": "qualquer endpoint com token real", "motivo": "exige segredo do Matheus - ver 'O que precisa do Matheus'" }
  ]
}
